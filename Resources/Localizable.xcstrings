        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后宠物的台词由设备端模型生成，完全离线。代价是约 1.4 GB 内存占用，会让 app 挂后台时更容易被系统回收。"
          }
        }
      }
