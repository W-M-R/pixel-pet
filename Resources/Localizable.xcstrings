    "line.sleepy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for bed…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要睡觉了呢"
          }
        }
