    "settings.name.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once named, it will use this name when it talks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起了名字之后，它说话时会用这个名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取名後，牠說話時會用這個名字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前をつけると、話すときにこの名前を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 지으면 말할 때 이 이름을 사용해요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Benennung wird dieser Name verwendet, wenn es spricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois nommé, il utilisera ce nom quand il parlera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez con nombre, lo usará cuando hable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta scelto, useremo questo nome quando parla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de nomeado, ele usará este nome quando falar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выбора имени питомец будет называть себя так."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد اختيار الاسم سيستخدمه عند الكلام."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम रखने के बाद बात करते समय वही नाम इस्तेमाल होगा।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตั้งชื่อแล้ว มันจะใช้ชื่อนี้เวลาพูด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah diberi nama, ia akan memakai nama ini saat berbicara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad verildikten sonra konuşurken bu adı kullanır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra het een naam heeft, gebruikt het die naam als het praat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det fått ett namn använder det namnet när det talar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nadaniu imienia zwierzak będzie się nim posługiwać."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đặt tên, nó sẽ dùng tên này khi nói."
          }
        }
      }
    },
