    "about.assets.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pet sprites are \"LPC Cats and Dogs\" by bluecarrot16 from OpenGameArt. Room and emote art is CC0. UI icons are original to this project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宠物精灵图来自 OpenGameArt 的「LPC Cats and Dogs」（作者 bluecarrot16），房间与表情素材为 CC0 授权，界面图标为本项目自绘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寵物圖像為 bluecarrot16 的「LPC Cats and Dogs」，來自 OpenGameArt。房間與表情圖為 CC0。UI 圖示為本專案原創。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットのスプライトは OpenGameArt の bluecarrot16 による「LPC Cats and Dogs」です。部屋と絵文字のアートは CC0。UI アイコンはこのプロジェクトのオリジナルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫 스프라이트는 OpenGameArt의 bluecarrot16이 만든 「LPC Cats and Dogs」입니다. 방과 이모트 아트는 CC0입니다. UI 아이콘은 이 프로젝트의 자체 제작입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tier-Sprites sind „LPC Cats and Dogs“ von bluecarrot16 aus OpenGameArt. Raum- und Emote-Grafiken sind CC0. Die UI-Symbole sind Originale dieses Projekts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sprites des animaux proviennent de « LPC Cats and Dogs » par bluecarrot16 sur OpenGameArt. Les décors et les émotes sont en CC0. Les icônes de l’interface sont originales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sprites de las mascotas son «LPC Cats and Dogs» de bluecarrot16, de OpenGameArt. Los gráficos de la habitación y los gestos son CC0. Los iconos de la interfaz son originales de este proyecto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sprite degli animali sono «LPC Cats and Dogs» di bluecarrot16, da OpenGameArt. La grafica della stanza e delle emote è CC0. Le icone dell’interfaccia sono originali di questo progetto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sprites dos bichinhos são «LPC Cats and Dogs», de bluecarrot16, do OpenGameArt. A arte do quarto e das emoções é CC0. Os ícones da interface são originais deste projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрайты питомцев — «LPC Cats and Dogs» от bluecarrot16 с OpenGameArt. Графика комнаты и эмоций — CC0. Иконки интерфейса созданы для этого проекта."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسوم الحيوانات من «LPC Cats and Dogs» بريشة bluecarrot16 من OpenGameArt. رسوم الغرفة والتعبيرات بترخيص CC0. أيقونات الواجهة من تصميم هذا المشروع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पालतू स्प्राइट OpenGameArt से bluecarrot16 की «LPC Cats and Dogs» हैं। कमरे और भाव की कलाकृति CC0 है। UI आइकन इस प्रोजेक्ट के लिए बनाए गए हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สไปรต์สัตว์เลี้ยงมาจาก «LPC Cats and Dogs» โดย bluecarrot16 จาก OpenGameArt ภาพห้องและอีโมทเป็น CC0 ไอคอนอินเทอร์เฟซออกแบบขึ้นสำหรับโปรเจกต์นี้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprite hewan berasal dari «LPC Cats and Dogs» oleh bluecarrot16 dari OpenGameArt. Gambar ruangan dan emote berlisensi CC0. Ikon antarmuka dibuat khusus untuk proyek ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evcil hayvan sprite’ları OpenGameArt’tan bluecarrot16 imzalı «LPC Cats and Dogs» çalışmasıdır. Oda ve ifade grafikleri CC0 lisanslıdır. Arayüz simgeleri bu proje için özgün olarak hazırlandı."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sprites van de dieren komen uit «LPC Cats and Dogs» van bluecarrot16 via OpenGameArt. De kamer- en emotekunst is CC0. De interface-iconen zijn origineel voor dit project."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Djurspritarna kommer från «LPC Cats and Dogs» av bluecarrot16 från OpenGameArt. Rums- och emotegrafiken är CC0. Gränssnittsikonerna är gjorda för det här projektet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprite’y zwierzaków to „LPC Cats and Dogs” autorstwa bluecarrot16 z OpenGameArt. Grafika pokoju i emotek jest na licencji CC0. Ikony interfejsu powstały specjalnie dla tego projektu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình sprite thú nuôi lấy từ «LPC Cats and Dogs» của bluecarrot16 trên OpenGameArt. Hình phòng và biểu cảm theo giấy phép CC0. Biểu tượng giao diện được thiết kế riêng cho dự án này."
          }
        }
      }
    },
