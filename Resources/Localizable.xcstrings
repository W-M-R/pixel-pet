    "reward.offline.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I earned %lld coins watching the house!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我帮你看家赚了 %lld 枚！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我幫你看家賺了 %lld 枚！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "留守番して %lld 枚かせいだよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집을 지켜서 %lld개 벌었어!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe beim Hüten %lld Münzen verdient!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai gagné %lld pièces en gardant la maison !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gané %lld monedas cuidando la casa!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho guadagnato %lld monete facendo la guardia!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhei %lld moedas cuidando da casa!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я присматривал за домом и заработал %lld монет!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرست البيت وجمعت %lld عملة!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर की रखवाली करके मैंने %lld सिक्के कमाए!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฝ้าบ้านแล้วได้ %lld เหรียญ!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku menjaga rumah dan dapat %lld koin!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evi bekleyip %lld para kazandım!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb %lld munten verdiend met op het huis passen!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag tjänade %lld mynt på att passa huset!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilnowałem domu i zarobiłem %lld monet!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tớ trông nhà và kiếm được %lld xu!"
          }
        }
      }
    },
