    "line.sleepy.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good night…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚安…"
          }
        }
      }
    },
    "line.stroked.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That feels so nice~"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好舒服呀~"
          }
        }
      }
    },
    "line.stroked.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More pets please"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再摸摸嘛"
          }
        }
