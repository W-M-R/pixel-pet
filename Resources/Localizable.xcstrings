    "settings.language.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies immediately. Falls back to English if a language is missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择后立刻生效。缺少译文时回退到英文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效。缺少譯文時回退英文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに反映されます。訳がない場合は英語になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 적용됩니다. 번역이 없으면 영어로 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt sofort. Fällt auf Englisch zurück, wenn eine Sprache fehlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application immédiate. Repli sur l’anglais si une langue manque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica de inmediato. Si falta un idioma, se usa el inglés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica subito. Se manca una lingua si usa l’inglese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica na hora. Se faltar um idioma, usa o inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется сразу. Если перевода нет, используется английский."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق فورًا. وعند غياب الترجمة تُستخدم الإنجليزية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत लागू होता है। अनुवाद न होने पर अंग्रेज़ी दिखती है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลทันที หากไม่มีคำแปลจะใช้ภาษาอังกฤษ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku langsung. Jika terjemahan tidak ada, bahasa Inggris dipakai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen uygulanır. Çeviri yoksa İngilizce kullanılır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt direct. Valt terug op Engels als een taal ontbreekt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäller direkt. Faller tillbaka på engelska om ett språk saknas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa od razu. Gdy brakuje tłumaczenia, używany jest angielski."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng ngay. Nếu thiếu bản dịch sẽ dùng tiếng Anh."
          }
        }
      }
    },
