          "stringUnit": {
            "state": "translated",
            "value": "조금 지저분해졌어요. 목욕을 시켜 주세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird etwas schmutzig – ein Bad würde helfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il devient un peu sale : un bain lui ferait du bien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está ensuciando un poco: un baño le vendría bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sta sporcando un po’: un bagno gli farebbe bene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está ficando meio sujo: um banho ajudaria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного запачкался — ванна пойдёт на пользу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
