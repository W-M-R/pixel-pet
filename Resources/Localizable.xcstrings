    "line.wokenUp.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You woke me up~"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被你叫醒了呢"
