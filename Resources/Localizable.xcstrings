    "onboard.pick.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each pet has different needs and earnings.\nPick the one that fits how you play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种宠物的需求和收益都不同。\n选一个适合你节奏的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隻寵物的需求與收益都不同。\n選一隻符合你玩法的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットごとに必要なお世話と収益がちがいます。\nあなたの遊び方に合う子を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫마다 필요한 돌봄과 수익이 달라요.\n당신의 플레이 방식에 맞는 친구를 골라 주세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Tier hat andere Bedürfnisse und Einnahmen.\nWähle das, das zu deinem Spielstil passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque animal a des besoins et des revenus différents.\nChoisis celui qui correspond à ta façon de jouer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mascota tiene necesidades e ingresos distintos.\nElige la que encaje con tu forma de jugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni animale ha esigenze e guadagni diversi.\nScegli quello che si adatta al tuo modo di giocare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bichinho tem necessidades e ganhos diferentes.\nEscolha o que combina com o seu jeito de jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого питомца свои потребности и доход.\nВыберите того, кто подходит вашему стилю игры."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل حيوان احتياجات وأرباح مختلفة.\nاختر ما يناسب طريقة لعبك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर साथी की ज़रूरतें और कमाई अलग होती है।\nजो आपके खेलने के तरीक़े से मेल खाए, उसे चुनें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัตว์เลี้ยงแต่ละตัวมีความต้องการและรายรับต่างกัน\nเลือกตัวที่เข้ากับสไตล์การเล่นของคุณ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hewan punya kebutuhan dan pemasukan berbeda.\nPilih yang sesuai dengan gaya bermainmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dostun ihtiyaçları ve geliri farklıdır.\nOyun tarzınıza uyanı seçin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk dier heeft andere behoeften en inkomsten.\nKies het dier dat bij jouw speelstijl past."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje djur har olika behov och inkomster.\nVälj det som passar ditt sätt att spela."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy zwierzak ma inne potrzeby i przychody.\nWybierz tego, który pasuje do Twojego stylu gry."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi con có nhu cầu và mức thu nhập khác nhau.\nHãy chọn con phù hợp với cách bạn chơi."
          }
        }
      }
    },
