      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mmm… what time is it?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唔…几点了？"
          }
