          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai agak kotor — mandi akan membantu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz kirlendi; yıkanmak iyi gelir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
