    "about.privacy.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the app deletes all data. No copies exist anywhere else."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 app 即删除全部数据，没有任何副本留在别处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 App 就會刪除所有資料。其他地方不存在任何副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを削除するとすべてのデータが削除されます。他の場所に控えは残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 삭제하면 모든 데이터가 삭제됩니다. 다른 곳에 사본은 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die App löschst, werden alle Daten gelöscht. Es gibt nirgendwo Kopien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l’app supprime toutes les données. Aucune copie n’existe ailleurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al borrar la app se borran todos los datos. No existe ninguna copia en otro sitio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminando l’app vengono eliminati tutti i dati. Non esiste alcuna copia altrove."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o app apaga todos os dados. Não existe cópia em nenhum outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление приложения удаляет все данные. Копий нигде не остаётся."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف التطبيق يحذف كل البيانات. لا توجد أي نسخة في مكان آخر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप हटाने से सारा डेटा हट जाता है। कहीं कोई प्रतिलिपि नहीं रहती।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบแอปจะลบข้อมูลทั้งหมด ไม่มีสำเนาอยู่ที่อื่น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus aplikasi akan menghapus semua data. Tidak ada salinan di tempat lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı silmek tüm verileri siler. Başka hiçbir yerde kopya kalmaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app verwijderen wist alle gegevens. Er bestaan nergens kopieën."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tar bort appen försvinner all data. Det finns inga kopior någon annanstans."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie aplikacji usuwa wszystkie dane. Nigdzie nie ma żadnych kopii."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá ứng dụng sẽ xoá toàn bộ dữ liệu. Không có bản sao nào ở nơi khác."
          }
        }
      }
    },
    "about.privacy.local": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pets, coins, and room layout are stored only on your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宠物、金币、房间布局都只存在你的设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的寵物、金幣與房間佈置只儲存在你的裝置上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペット、コイン、部屋のレイアウトは端末内にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫, 코인, 방 배치는 기기에만 저장됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tiere, Münzen und die Raumaufteilung werden nur auf deinem Gerät gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes animaux, tes pièces et l’agencement de la pièce sont stockés uniquement sur ton appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mascotas, monedas y la disposición de la habitación se guardan solo en tu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi animali, le monete e la disposizione della stanza sono salvati solo sul tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus bichinhos, moedas e a disposição do quarto ficam salvos apenas no seu aparelho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Питомцы, монеты и расстановка в комнате хранятся только на вашем устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ حيواناتك وعملاتك وترتيب الغرفة على جهازك فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके साथी, सिक्के और कमरे की सजावट केवल आपके डिवाइस पर सहेजे जाते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัตว์เลี้ยง เหรียญ และการจัดวางในห้องถูกเก็บไว้บนอุปกรณ์ของคุณเท่านั้น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hewan, koin, dan tata letak ruangan hanya disimpan di perangkatmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostlarınız, paralarınız ve oda düzeniniz yalnızca cihazınızda saklanır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dieren, munten en kamerindeling worden alleen op je apparaat opgeslagen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina djur, mynt och rumsplacering sparas bara på din enhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zwierzaki, monety i układ pokoju są przechowywane tylko na Twoim urządzeniu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thú nuôi, xu và cách bố trí phòng chỉ được lưu trên thiết bị của bạn."
          }
        }
      }
    },
    "about.privacy.no_account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account required. No personal data collected. No analytics, no ads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要账号，不收集任何个人信息，没有统计和广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無須帳號。不收集個人資料。沒有分析追蹤，沒有廣告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要。個人情報は収集しません。解析も広告もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요 없습니다. 개인정보를 수집하지 않습니다. 분석도 광고도 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto nötig. Keine personenbezogenen Daten. Keine Analyse, keine Werbung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte requis. Aucune donnée personnelle collectée. Ni analyse, ni publicité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta cuenta. No se recogen datos personales. Sin analíticas ni anuncios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account richiesto. Nessun dato personale raccolto. Nessuna analisi, nessuna pubblicità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa de conta. Nenhum dado pessoal é coletado. Sem análises, sem anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт не нужен. Личные данные не собираются. Ни аналитики, ни рекламы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حاجة لحساب. لا تُجمع بيانات شخصية. لا تحليلات ولا إعلانات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते की ज़रूरत नहीं। कोई निजी जानकारी नहीं ली जाती। न विश्लेषण, न विज्ञापन।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี ไม่เก็บข้อมูลส่วนบุคคล ไม่มีการวิเคราะห์ ไม่มีโฆษณา"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu akun. Tidak ada data pribadi yang dikumpulkan. Tanpa analitik, tanpa iklan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap gerekmez. Kişisel veri toplanmaz. Analiz yok, reklam yok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account nodig. Geen persoonsgegevens verzameld. Geen analyse, geen advertenties."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto behövs. Inga personuppgifter samlas in. Ingen analys, inga annonser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto nie jest potrzebne. Nie zbieramy danych osobowych. Bez analityki i reklam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Không thu thập dữ liệu cá nhân. Không phân tích, không quảng cáo."
          }
        }
      }
    },
    "about.privacy.notify": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only permission requested is notifications — off by default, used solely for pet status reminders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一会请求的权限是通知，默认关闭，只用于提醒宠物的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一要求的權限是通知 —— 預設關閉，僅用於寵物狀態提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求する権限は通知のみです。既定はオフで、ペットの状態のお知らせにのみ使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하는 권한은 알림뿐입니다. 기본은 꺼져 있고, 펫 상태 알림에만 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzige angeforderte Berechtigung sind Mitteilungen – standardmäßig aus, nur für Hinweise zum Zustand deines Tiers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule autorisation demandée concerne les notifications : désactivées par défaut, elles servent uniquement aux rappels d’état."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El único permiso que se solicita es el de notificaciones: desactivado por defecto y usado solo para avisos del estado de la mascota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’unico permesso richiesto è quello per le notifiche: disattivato per impostazione predefinita e usato solo per gli avvisi sullo stato dell’animale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A única permissão solicitada é a de notificações: desativada por padrão e usada apenas para avisos sobre o estado do bichinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивается только разрешение на уведомления — по умолчанию выключены и нужны лишь для напоминаний о состоянии питомца."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإذن الوحيد المطلوب هو الإشعارات، وهو معطّل تلقائيًا ويُستخدم فقط لتنبيهات حالة الحيوان."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सूचनाओं की अनुमति माँगी जाती है — डिफ़ॉल्ट रूप से बंद, और सिर्फ़ साथी की स्थिति की याद दिलाने के लिए।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์เดียวที่ขอคือการแจ้งเตือน ซึ่งปิดไว้เป็นค่าเริ่มต้น และใช้เพื่อเตือนสถานะสัตว์เลี้ยงเท่านั้น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu-satunya izin yang diminta adalah notifikasi — nonaktif secara bawaan dan hanya untuk pengingat kondisi hewan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstenen tek izin bildirimlerdir; varsayılan olarak kapalıdır ve yalnızca durum hatırlatmaları için kullanılır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De enige gevraagde toestemming is voor meldingen — standaard uit en alleen voor herinneringen over de toestand van je dier."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den enda behörighet som efterfrågas är aviseringar – avstängda som standard och används bara för påminnelser om djurets tillstånd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedyne wymagane uprawnienie to powiadomienia — domyślnie wyłączone, używane wyłącznie do przypomnień o stanie zwierzaka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền duy nhất được yêu cầu là thông báo — mặc định tắt và chỉ dùng để nhắc về trạng thái thú nuôi."
          }
        }
      }
    },
    "about.privacy.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fully offline — the app makes no network requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全离线运行，app 不发起任何网络请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全離線 —— App 不發送任何網路請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全オフライン。ネットワーク通信は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전 오프라인 — 앱은 어떤 네트워크 요청도 하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig offline – die App stellt keine Netzwerkanfragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entièrement hors ligne : l’app n’effectue aucune requête réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalmente sin conexión: la app no hace ninguna petición de red."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamente offline: l’app non effettua alcuna richiesta di rete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalmente offline: o app não faz nenhuma requisição de rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью офлайн — приложение не отправляет сетевых запросов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل دون اتصال تمامًا؛ لا يُجري التطبيق أي طلبات شبكة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी तरह ऑफ़लाइन — ऐप कोई नेटवर्क अनुरोध नहीं करता।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออฟไลน์ทั้งหมด แอปไม่มีการเรียกเครือข่ายใด ๆ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepenuhnya offline — aplikasi tidak melakukan permintaan jaringan apa pun."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen çevrimdışı; uygulama hiçbir ağ isteği yapmaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledig offline — de app doet geen enkel netwerkverzoek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Helt offline – appen gör inga nätverksanrop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pełni offline — aplikacja nie wysyła żadnych żądań sieciowych."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn toàn offline — ứng dụng không gửi bất kỳ yêu cầu mạng nào."
          }
        }
      }
    },
