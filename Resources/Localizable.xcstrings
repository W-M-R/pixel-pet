    "notify.bored.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ misses you. Come play!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想你了，回来陪它玩会儿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想你了。來陪牠玩！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が寂しがっています。遊びに来て！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 보고 싶어 해요. 놀아 주세요!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vermisst dich. Komm spielen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’ennuie de toi. Viens jouer !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te echa de menos. ¡Ven a jugar!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ti pensa. Vieni a giocare!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está com saudade. Venha brincar!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ скучает по вам. Приходите поиграть!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يشتاق إليك. تعال والعب!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को आपकी याद आ रही है। खेलने आइए!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ คิดถึงคุณ มาเล่นกันหน่อย!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ merindukanmu. Ayo bermain!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sizi özledi. Oynamaya gelin!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mist je. Kom spelen!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saknar dig. Kom och lek!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ za Tobą tęskni. Przyjdź się pobawić!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang nhớ bạn. Vào chơi cùng nhé!"
          }
        }
      }
    },
