      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just five more minutes…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我还想再睡会儿"
