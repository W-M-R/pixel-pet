    "settings.notify.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get notified when it's hungry or bored. Quiet at night."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它饿了或无聊时提醒你。深夜不打扰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在牠餓了或無聊時通知你。夜間安靜。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おなかがすいたり退屈したときにお知らせします。夜間は静かです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배고프거나 심심할 때 알려 줘요. 밤에는 조용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde benachrichtigt, wenn es hungrig oder gelangweilt ist. Nachts still."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois prévenu quand il a faim ou s’ennuie. Silence la nuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso cuando tenga hambre o se aburra. Silencio por la noche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando ha fame o si annoia. Silenzio di notte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um aviso quando ele estiver com fome ou sem graça. Silêncio à noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте напоминание, когда питомец голоден или скучает. Ночью тихо."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ننبّهك عندما يجوع أو يضجر. هدوء في الليل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूख लगने या बोर होने पर सूचना पाएँ। रात में शांत।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับแจ้งเมื่อมันหิวหรือเบื่อ กลางคืนจะเงียบ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat pemberitahuan saat ia lapar atau bosan. Malam hari senyap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acıktığında veya sıkıldığında haber verir. Geceleri sessiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg bericht als het honger heeft of zich verveelt. ’s Nachts stil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få ett meddelande när det är hungrigt eller uttråkat. Tyst på natten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowiesz się, gdy będzie głodny lub znudzony. Nocą cisza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo khi nó đói hoặc buồn. Ban đêm sẽ im lặng."
          }
        }
      }
    },
