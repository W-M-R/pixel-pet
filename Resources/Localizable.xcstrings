    "achv.all_high.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep fullness, mood, and hygiene all above 90% (after feeding, playing, and bathing at least once)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喂食、玩耍、洗澡各做过一次后，让三维同时保持 90% 以上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓飽足、心情、清潔都保持在 90% 以上（需各做過一次餵食、玩耍、洗澡）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "満腹度・気分・清潔さをすべて 90% 以上に保つ（ごはん・遊び・お風呂を各 1 回以上したあと）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배부름·기분·청결을 모두 90% 이상으로 유지（먹이·놀이·목욕을 각각 한 번 이상 한 뒤）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sättigung, Laune und Sauberkeit alle über 90 % halten (nach mindestens einmal Füttern, Spielen und Baden)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir satiété, humeur et propreté au-dessus de 90 % (après avoir nourri, joué et lavé au moins une fois)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener saciedad, ánimo e higiene por encima del 90 % (después de dar de comer, jugar y bañar al menos una vez)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere sazietà, umore e igiene tutti sopra il 90% (dopo aver dato da mangiare, giocato e lavato almeno una volta)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter saciedade, humor e higiene acima de 90% (depois de alimentar, brincar e dar banho pelo menos uma vez)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать сытость, настроение и чистоту выше 90 % (после того как хотя бы раз покормили, поиграли и помыли)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على الشبع والمزاج والنظافة فوق ٩٠٪ (بعد الإطعام واللعب والغسل مرة واحدة على الأقل)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेट, मनोदशा और सफ़ाई सभी को 90% से ऊपर रखें (कम से कम एक बार खिलाने, खेलने और नहलाने के बाद)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาความอิ่ม อารมณ์ และความสะอาดให้เกิน 90% (หลังให้อาหาร เล่น และอาบน้ำอย่างน้อยหนึ่งครั้ง)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga kekenyangan, suasana hati, dan kebersihan semuanya di atas 90% (setelah memberi makan, bermain, dan memandikan setidaknya sekali)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokluk, moral ve temizliği %90’ın üzerinde tutun (en az bir kez besleme, oynama ve yıkamadan sonra)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd verzadiging, humeur en hygiëne allemaal boven 90% (na minstens één keer voeren, spelen en baden)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll mättnad, humör och renlighet över 90 % (efter att ha matat, lekt och badat minst en gång)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymać sytość, nastrój i czystość powyżej 90% (po co najmniej jednym karmieniu, zabawie i kąpieli)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ độ no, tâm trạng và vệ sinh đều trên 90% (sau khi đã cho ăn, chơi và tắm ít nhất một lần)"
          }
        }
      }
    },
