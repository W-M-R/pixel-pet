    },
    "line.stroked.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I love you the most"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最喜欢你了"
          }
        }
      }
    },
    "line.veryHungry.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm starving!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我快饿晕了！"
          }
        }
      }
    },
    "line.veryHungry.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven't eaten in ages…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好久没吃东西了…"
          }
        }
      }
    },
    "line.veryHungry.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, feed me…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "求求你，喂喂我"
          }
        }
      }
    },
