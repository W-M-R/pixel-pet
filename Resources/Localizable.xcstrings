    "line.bored.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So bored…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好无聊呀"
          }
        }
      }
    },
    "line.bored.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play with me a bit?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陪我玩一会儿嘛"
          }
        }
      }
    },
    "line.bored.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I miss you a little"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有点想你了"
          }
        }
      }
    },
    "line.bored.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What shall we do today?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天做什么呢？"
          }
        }
      }
    },
    "line.cleaned.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All clean now!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变干净啦！"
          }
        }
      }
    },
    "line.cleaned.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I smell nice~"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "香香的~"
          }
        }
      }
    },
    "line.cleaned.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My fur is so soft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "毛毛滑滑的"
          }
        }
      }
    },
    "line.dirty.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I feel a bit grubby"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身上有点脏了"
          }
        }
      }
    },
    "line.dirty.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'd like a bath…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想洗个澡…"
          }
        }
      }
    },
    "line.dirty.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My fur is a mess"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "毛毛乱糟糟的"
          }
        }
      }
    },
    "line.dirty.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brush me please?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我梳梳毛？"
          }
        }
      }
    },
    "line.fed.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yummy! Thank you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好好吃！谢谢你"
          }
        }
      }
    },
    "line.fed.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All full now~"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吃饱啦，满足"
          }
        }
      }
    },
    "line.fed.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's my favorite!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个我最爱吃了"
          }
        }
      }
    },
    "line.greeting.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're here!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你来啦！"
          }
        }
      }
    },
    "line.greeting.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi there!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨，主人"
          }
        }
      }
    },
    "line.greeting.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在等你呢"
          }
        }
      }
    },
    "line.happy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling great today!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天心情超好！"
          }
        }
      }
    },
    "line.happy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So happy with you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和你在一起真开心"
          }
        }
      }
    },
    "line.happy.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purr purr~"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼噜呼噜~"
          }
        }
      }
    },
    "line.happy.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a lovely day!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天是好日子！"
          }
        }
      }
    },
    "line.hungry.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My tummy is rumbling…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肚子有点饿了…"
          }
        }
      }
    },
    "line.hungry.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could I have a snack?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能给我点吃的吗？"
          }
        }
      }
    },
    "line.hungry.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I smell something tasty!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闻到食物的味道了！"
          }
        }
      }
    },
    "line.hungry.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My bowl looks empty…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "碗好像空了呢"
          }
        }
      }
    },
    "line.longAbsence.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're finally back!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你终于回来了！"
          }
        }
      }
    },
    "line.longAbsence.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I missed you so much"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好久不见，我很想你"
          }
        }
      }
    },
    "line.longAbsence.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've been waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我一直在等你哦"
          }
        }
      }
    },
    "line.sleepy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So sleepy…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好困呀…"
          }
        }
      }
