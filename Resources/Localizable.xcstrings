      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, your pet's lines are generated on-device, fully offline. Costs about 1.4 GB of memory, which makes the app more likely to be unloaded in the background."
