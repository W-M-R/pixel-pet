    },
    "line.sleepy.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't keep my eyes open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛睁不开了"
          }
        }
