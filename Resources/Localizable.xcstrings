    "pets.name_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the name can change. Coat is set at adoption."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有名字可以改。毛色在收养时就定下来了。"
