    "settings.threshold.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifies you when a stat drops below the chosen level. Pick × to turn it off. Late-night reminders (23:00–07:00) are pushed to morning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态低于所选比例时提醒。选「×」关闭该项。深夜（23:00–07:00）的提醒会推迟到早上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當某項狀態低於所選等級時通知你。選 × 可關閉。深夜提醒（23:00–07:00）會延到早上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ水準を下回るとお知らせします。× でオフにできます。深夜（23:00〜07:00）のお知らせは朝にまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 수준보다 낮아지면 알려 줘요. ×를 고르면 끌 수 있어요. 늦은 밤（23:00–07:00）알림은 아침으로 미룹니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigt dich, wenn ein Wert unter die gewählte Stufe fällt. Wähle ×, um es auszuschalten. Hinweise in der Nacht (23:00–07:00) werden auf den Morgen verschoben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te prévient quand une jauge passe sous le niveau choisi. Choisis × pour désactiver. Les rappels de nuit (23 h–7 h) sont repoussés au matin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa cuando un indicador baja del nivel elegido. Elige × para desactivarlo. Los avisos de madrugada (23:00–07:00) se posponen a la mañana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa quando un indicatore scende sotto il livello scelto. Scegli × per disattivare. Gli avvisi notturni (23:00–07:00) vengono spostati al mattino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando um medidor cair abaixo do nível escolhido. Escolha × para desativar. Avisos da madrugada (23:00–07:00) vão para a manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напомним, когда показатель опустится ниже выбранного уровня. Выберите ×, чтобы отключить. Ночные напоминания (23:00–07:00) переносятся на утро."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ننبّهك عندما ينزل مؤشر تحت المستوى المختار. اختر × للإيقاف. تنبيهات الليل (٢٣:٠٠–٠٧:٠٠) تُؤجَّل إلى الصباح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आँकड़ा चुने हुए स्तर से नीचे जाए तो सूचित करेंगे। बंद करने के लिए × चुनें। देर रात (23:00–07:00) की सूचनाएँ सुबह पर टाल दी जाती हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเตือนเมื่อค่าสถานะต่ำกว่าระดับที่เลือก เลือก × เพื่อปิด การเตือนช่วงดึก (23:00–07:00) จะเลื่อนไปตอนเช้า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu saat suatu statistik turun di bawah level pilihan. Pilih × untuk menonaktifkan. Pengingat tengah malam (23.00–07.00) digeser ke pagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gösterge seçtiğiniz seviyenin altına düştüğünde haber verir. Kapatmak için × seçin. Gece yarısı (23.00–07.00) hatırlatmaları sabaha ertelenir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwt je als een waarde onder het gekozen niveau zakt. Kies × om uit te zetten. Herinneringen ’s nachts (23:00–07:00) worden naar de ochtend geschoven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelar dig när ett värde sjunker under den valda nivån. Välj × för att stänga av. Påminnelser på natten (23:00–07:00) skjuts till morgonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomimy, gdy wskaźnik spadnie poniżej wybranego poziomu. Wybierz ×, aby wyłączyć. Nocne przypomnienia (23:00–07:00) przenosimy na rano."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc bạn khi một chỉ số xuống dưới mức đã chọn. Chọn × để tắt. Nhắc lúc khuya (23:00–07:00) sẽ dời sang buổi sáng."
          }
        }
      }
    },
